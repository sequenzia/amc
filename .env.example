# Agent Messaging Channel (AMC) — environment configuration.
# Copy this file to `.env` (in repo root for dev) or to
# `~/.config/messaging-agent/.env` (for production install) and fill in values.
# Source: specs/agent-messaging-channel-SPEC.md §11.2.

# --- HTTP bind ------------------------------------------------------------
# Host the adapter binds to. Default: 127.0.0.1 (loopback only).
AMC_BIND_HOST=127.0.0.1
# Port the adapter binds to. Default: 8080.
AMC_BIND_PORT=8080

# --- Authentication -------------------------------------------------------
# Bearer token required on all REST endpoints. REQUIRED — no default.
# Generate with e.g.: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
AMC_BEARER_TOKEN=

# --- Storage paths --------------------------------------------------------
# SQLite database file path.
# Default: ~/Library/Application Support/messaging-agent/state.db
AMC_DB_PATH=~/Library/Application Support/messaging-agent/state.db
# Local attachment store directory.
# Default: ~/Library/Application Support/messaging-agent/attachments
AMC_ATTACHMENT_DIR=~/Library/Application Support/messaging-agent/attachments
# Log file destination directory.
# Default: ~/Library/Logs/messaging-agent
AMC_LOG_DIR=~/Library/Logs/messaging-agent
# Allowlist TOML file path.
# Default: ~/.config/messaging-agent/allowlist.toml
AMC_ALLOWLIST_PATH=~/.config/messaging-agent/allowlist.toml

# --- Webhook --------------------------------------------------------------
# Outbound webhook URL for new-message notifications. Empty disables.
# Default: "" (disabled)
AMC_WEBHOOK_URL=
# HMAC shared secret signed into webhook deliveries.
# REQUIRED if AMC_WEBHOOK_URL is non-empty.
AMC_WEBHOOK_SECRET=

# --- Discord --------------------------------------------------------------
# Discord bot token. REQUIRED if Discord connector is enabled.
AMC_DISCORD_BOT_TOKEN=

# --- Rate limiting --------------------------------------------------------
# Per-channel token-bucket sustained rate (msgs/sec). Default: 1.
AMC_RATE_LIMIT_PER_CHANNEL_RPS=1
# Per-channel token-bucket burst capacity. Default: 5.
AMC_RATE_LIMIT_PER_CHANNEL_BURST=5

# --- Attachment retention -------------------------------------------------
# Days to retain re-hosted attachments before sweeper deletes them.
# Default: 90.
AMC_ATTACHMENT_RETENTION_DAYS=90
